# Root .gitignore for InAmigos MERN project
# -------------------------------------------------
# Node.js dependencies
node_modules/

# Build output (client)
client/dist/
client/.vite/

# Server build (if any)
server/build/

# Environment variables – keep local secrets out of repo
*.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor folders
.vscode/
.idea/

# Optional npm cache
.cache/
